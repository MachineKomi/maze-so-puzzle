{
  "name": "maze-so-puzzle",
  "private": true,
  "version": "0.22.0",
  "description": "A gentle, child-friendly maze adventure for the browser and Windows.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MachineKomi/maze-so-puzzle.git"
  },
  "bugs": {
    "url": "https://github.com/MachineKomi/maze-so-puzzle/issues"
  },
  "homepage": "https://github.com/MachineKomi/maze-so-puzzle#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/performance/build-provenance.mjs",
    "check": "npm test && npm run build",
    "check:desktop": "cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf:check": "node scripts/performance/check-contracts.mjs && node scripts/performance/check-budgets.mjs && node scripts/performance/validate-evidence.mjs docs/performance/evidence",
    "perf:inventory": "node scripts/performance/inventory.mjs",
    "perf:browser": "playwright test --config scripts/performance/playwright.config.mjs",
    "perf:tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/performance/tauri-baseline.ps1",
    "perf:validate": "node scripts/performance/validate-evidence.mjs",
    "art:check": "python scripts/art_pipeline.py --check",
    "art:test": "python -m unittest discover -s scripts/art_pipeline/tests -p \"test_*.py\"",
    "art:proof": "python scripts/art_pipeline.py --proof canary",
    "art:proof:mgjrpg02": "python scripts/art_pipeline.py --proof mgjrpg-02-canary",
    "art:proof:mgjrpg02:options": "python scripts/art_pipeline.py --proof mgjrpg-02-options",
    "art:proof:mgjrpg02:selection": "python scripts/art_pipeline.py --proof mgjrpg-02-selection",
    "art:proof:mgjrpg02:batch01": "python scripts/art_pipeline/mgjrpg02_batch01.py",
    "art:proof:mgjrpg02:batch01:r02": "python scripts/art_pipeline/mgjrpg02_batch01.py --source-root docs/source-assets/production/mgjrpg-02/batch-01-r02 --output-root artifacts/art-proofs/mgjrpg-02/batches/batch-01-r02",
    "art:publish:mgjrpg02:plan": "python scripts/art_pipeline/mgjrpg02_publish.py --plan",
    "art:publish:mgjrpg02": "python scripts/art_pipeline/mgjrpg02_publish.py --publish",
    "art:publish:mgjrpg02:check": "python scripts/art_pipeline/mgjrpg02_publish.py --check",
    "art:build": "python scripts/art_pipeline.py --build",
    "art:manifest": "python scripts/art_pipeline.py --manifest",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles nsis"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
